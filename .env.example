# 复制为 .env 后填写（已在 .gitignore，不会进仓库）
AIPAIBOX_API_KEY=sk-your-token-here
AIPAIBOX_BASE_URL=https://api.aipaibox.com
# 文生图模型（须与令牌分组在模型广场已开通的图像模型一致，常见 dall-e-3）
# IMAGE_GEN_MODEL=dall-e-3
# 或多个候选，按顺序尝试：IMAGE_GEN_MODELS=dall-e-3,dall-e-2
# 文生图默认固定即梦（与聊天模型无关）；仅调试时可改回 OpenAI 兼容接口：
# IMAGE_GEN_BACKEND=openai
# 即梦 AI（火山引擎 IAM 密钥，勿填 apikey-… 令牌）
# VOLC_ACCESSKEY=AKLTxxxxxxxx
# VOLC_SECRETKEY=xxxxxxxxxxxxxxxx
# 联网搜索（Tavily，https://tavily.com 注册 API Key）
# TAVILY_API_KEY=tvly-xxxxxxxx

# Pipecat voice bot settings
# PIPECAT_LLM_API_KEY=sk-xxxxxxxx
# PIPECAT_LLM_BASE_URL=https://api.openai.com/v1
# PIPECAT_LLM_MODEL=gpt-4o-mini
# PIPECAT_STT_API_KEY=sk-xxxxxxxx
# PIPECAT_STT_BASE_URL=https://api.openai.com/v1
# PIPECAT_STT_MODEL=gpt-4o-mini-transcribe
# BAIDU_ASR_APP_ID=...
# BAIDU_ASR_API_KEY=...
# BAIDU_ASR_SECRET_KEY=...
# BAIDU_ASR_DEV_PID=1537
# NAILONG_TTS_BASE_URL=http://127.0.0.1:9880
